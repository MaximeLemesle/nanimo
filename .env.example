# Supabase - Project Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Sign in with Apple
APPLE_SERVICE_ID=com.example.nanimo.service

# RevenueCat - public SDK keys, safe to ship in the app (never the secret key).
# Missing keys only disable the paywall, the rest of the app keeps working.
REVENUECAT_IOS_API_KEY=appl_your-ios-key
REVENUECAT_ANDROID_API_KEY=goog_your-android-key

# Firebase - public client values, for server pushes. Leave empty to disable them.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# Sentry - crash reporting. Leave empty to disable it entirely.
SENTRY_DSN=

# PostHog product analytics. Release builds only, EU region.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
