# Nanimo — variables d'environnement (copiez en `.env`, gitignoré)
# N'y mettez que des valeurs PUBLIQUES : ce fichier est embarqué dans les assets
# de l'app et se retrouve en clair dans l'APK/IPA.

# Supabase — Project Settings › API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In — Google Cloud Console › Credentials (OAuth client IDs)
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Sign in with Apple — Services ID (identifiant du service, pas l'App ID)
APPLE_SERVICE_ID=com.example.nanimo.service
