# Development environment (NAN-063). Copy to env/dev.env, never commit it.
# Run with: flutter run --dart-define=ENV=dev
# Same keys as .env.example, pointing at the nanimo-dev Supabase project.

SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key

GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
APPLE_SERVICE_ID=com.example.nanimo.service

REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
